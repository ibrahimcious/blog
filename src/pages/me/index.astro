---
import { Header } from "@components/misc";
import { BaseHead } from "@components/seo";
import { AUTHOR_IMAGE, AUTHOR_NAME, socialLinks } from "@data/index";
import RootLayout from "@layouts/root-layout.astro";
import { absoluteUrl, profilePageJsonLd } from "@utils/seo";

const pageUrl = absoluteUrl("/me");
const pageTitle = "about ibrahim aji";
const pageDescription =
	"ibrahim aji — civil servant at bapenda kabupaten pasuruan and self-taught developer building tools that make government data work better.";
const jsonLd = profilePageJsonLd({
	url: pageUrl,
	name: `${AUTHOR_NAME} — about`,
	description: pageDescription,
	imageOrigin: Astro.url,
});
---

<!doctype html>
<html lang='en'>
	<head>
		<BaseHead
			title={pageTitle}
			description={pageDescription}
			jsonLd={jsonLd}
		/>
	</head>

	<RootLayout>
		<div
			id='og-page'
			class='flex flex-col w-full gap-12 max-w-xl lowercase'>
			<Header />

			<!-- Hero Section -->
			<div
				id='hero'
				class='flex flex-col gap-6'>
				<div class='flex flex-col sm:flex-row items-start sm:items-center gap-6'>
					<div class='relative group'>
						<img
							id='headshot-image'
							src={AUTHOR_IMAGE}
							alt='Ibrahim Aji'
							width='160'
							height='160'
							fetchpriority='high'
							decoding='async'
							class='w-32 h-32 sm:w-40 sm:h-40 rounded-full object-cover border-2 border-white flex-shrink-0 transition-opacity duration-300 group-hover:opacity-75'
						/>
						<button
							id='download-headshot'
							class='absolute inset-0 flex items-center justify-center rounded-full bg-black/60 dark:bg-black/70 opacity-0 group-hover:opacity-100 transition-opacity duration-300 cursor-pointer'>
							<span class='text-white font-medium text-sm px-4 py-2 rounded-full bg-white/20 backdrop-blur-sm'>
								download
							</span>
						</button>
					</div>
					<div class='flex flex-col gap-2'>
						<h1
							class='text-[min(10vw,64px)] font-medium leading-[0.9] tracking-[-2px] sm:tracking-[-3px]'>
							ibrahim aji
						</h1>
						<p class='text-xl font-medium text-gray-500 dark:text-gray-400'>
							developer · civil servant
						</p>
					</div>
				</div>
			</div>

			<!-- Bio Section -->
			<div
				id='bio'
				class='flex flex-col gap-6'>
				<h2 class='text-4xl font-medium tracking-tight text-gray-900 dark:text-white'>
					bio
				</h2>
				<div class='flex flex-col gap-4'>
					<p class='font-medium text-xl text-gray-700 dark:text-gray-300 leading-relaxed'>
						Ibrahim Aji is a civil servant and self-taught developer based in
						East Java, Indonesia. By day he runs data and information management
						at Bapenda Kabupaten Pasuruan, the regional revenue agency. By night
						he builds software that replaces manual government workflows.
					</p>
				</div>
			</div>

			<!-- Extended Bio Section -->
			<div
				id='extended-bio'
				class='flex flex-col gap-6'>
				<h2 class='text-4xl font-medium tracking-tight text-gray-900 dark:text-white'>
					extended bio
				</h2>
				<div class='flex flex-col gap-4'>
					<p class='font-medium text-xl text-gray-700 dark:text-gray-300 leading-relaxed'>
						Ibrahim is Kasubbid Pengelolaan Data dan Informasi at Bapenda
						(Regional Revenue Agency) Kabupaten Pasuruan, East Java. His work
						spans data and information management, ETPD — the electronification
						of regional government transactions — and tax base development.
					</p>
					<p class='font-medium text-xl text-gray-700 dark:text-gray-300 leading-relaxed'>
						He's a self-taught developer bridging civil service with modern web
						development. He works in TypeScript, TanStack, Prisma, and Hono, and
						reaches for Python and pandas when the job is data. Most of what he
						builds is internal tooling that takes a manual government process and
						turns it into something reliable.
					</p>
					<p class='font-medium text-xl text-gray-700 dark:text-gray-300 leading-relaxed'>
						He's currently working on <a
							href='https://siverina.pasuruankab.go.id'
							target='_blank'
							rel='noopener noreferrer'
							class='underline underline-offset-2'
							>SIVERINA</a
						>, a system built for the agency's data work.
					</p>
					<p class='font-medium text-xl text-gray-700 dark:text-gray-300 leading-relaxed'>
						Away from a screen, he's a former trail and ultra runner. These days
						the training is a little more casual.
					</p>
				</div>
			</div>

			<!-- Contact Section -->
			<div
				id='contact'
				class='flex flex-col gap-6'>
				<h2 class='text-4xl font-medium tracking-tight text-gray-900 dark:text-white'>
					contact
				</h2>
				<p class='font-medium text-xl text-gray-700 dark:text-gray-300'>
					Want to chat?
					<a
						href='mailto:ibrahimcious@gmail.com?subject=Hello&body=Hi%20Ibrahim%2C%0D%0A%0D%0A'
						class='underline underline-offset-2'>
						drop me a line
					</a>
				</p>
			</div>

			<!-- Social Links Section -->
			<div
				id='social-links'
				class='flex flex-col gap-6 pt-6 border-t border-gray-200 dark:border-gray-800'>
				<h2 class='text-4xl font-medium tracking-tight text-gray-900 dark:text-white'>
					find me
				</h2>
				<div class='flex flex-row gap-6 flex-wrap'>
					{
						socialLinks.map((link) => (
							<a
								href={link.url}
								rel={link.me ? 'me noopener noreferrer' : undefined}
								target={link.url.startsWith('mailto:') ? undefined : '_blank'}
								class='text-xl font-medium text-gray-700 dark:text-gray-300 hover:text-gray-900 dark:hover:text-gray-100 hover:underline underline-offset-2 transition-colors'>
								{link.label}
							</a>
						))
					}
				</div>
			</div>
		</div>
	</RootLayout>

	<script is:inline>
		document.addEventListener('DOMContentLoaded', () => {
			const downloadButton = document.getElementById('download-headshot');
			const headshotImage = document.getElementById('headshot-image');

			if (downloadButton && headshotImage && headshotImage instanceof HTMLImageElement) {
				downloadButton.addEventListener('click', async (e) => {
					e.preventDefault();
					e.stopPropagation();

					try {
						const imageUrl = headshotImage.src;
						const response = await fetch(imageUrl);
						const blob = await response.blob();
						const url = window.URL.createObjectURL(blob);
						const a = document.createElement('a');
						a.href = url;
						a.download = 'ibrahim-aji.svg';
						document.body.appendChild(a);
						a.click();
						document.body.removeChild(a);
						window.URL.revokeObjectURL(url);
					} catch (error) {
						console.error('Error downloading image:', error);
						window.open(headshotImage.src, '_blank');
					}
				});
			}
		});
	</script>
</html>
