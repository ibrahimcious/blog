---
import { ProductDock } from "@components/interactive";
import { Header } from "@components/misc";
import { BaseHead } from "@components/seo";
import { SITE_DESCRIPTION, socialLinks } from "@data/index";
import RootLayout from "@layouts/root-layout.astro";
---

<!doctype html>
<html lang='en'>
	<head>
		<BaseHead
			title="ibrahim aji — developer, civil servant"
			description={SITE_DESCRIPTION}
			image='/images/ogimage.png'
		/>
	</head>

	<RootLayout>
		<div
			id='navbar+title'
			class='flex flex-col w-full gap-6 max-w-xl lowercase'>
			<Header />
			<h1
				class='w-full text-start text-[min(12vw,72px)] font-medium leading-[0.9] tracking-[-2px] sm:tracking-[-4px]'>
				ibrahim aji
				<span class='block text-gray-500 dark:text-gray-400'
					>developer, civil servant</span
				>
			</h1>

			<div
				id='about'
				class='flex flex-col gap-4'>
				<div class='font-medium text-lg text-gray-700 dark:text-gray-400'>
					I'm Kasubbid Pengelolaan Data dan Informasi at Bapenda Kabupaten
					Pasuruan, the regional revenue agency in East Java. My work runs
					across data and information management, ETPD (electronification of
					regional government transactions), and tax base development.
				</div>

				<div class='font-medium text-lg text-gray-700 dark:text-gray-400'>
					By night I'm a self-taught developer. I build internal tools with
					TypeScript, TanStack, Prisma, and Hono — plus Python and pandas for
					the data work — replacing manual government workflows with software
					that holds up.
				</div>

				<div class='font-medium text-lg text-gray-700 dark:text-gray-300'>
					One of those tools is
					<ProductDock />
				</div>

				<div class='font-medium text-lg text-gray-700 dark:text-gray-400'>
					Former trail and ultra runner. Still running, just more casually
					these days.
				</div>

				<div class='font-medium text-lg text-gray-700 dark:text-gray-400'>
					Want to chat?{" "}
					<a
						href='mailto:ibrahimcious@gmail.com'
						class='underline underline-offset-2'>
						drop me a line
					</a>
				</div>
			</div>

			<div
				id='social-links'
				class='flex flex-row gap-4'>
				{
					socialLinks.map((link) => (
						<a
							href={link.url}
							rel={link.me ? 'me noopener noreferrer' : undefined}
							target={link.url.startsWith('mailto:') ? undefined : '_blank'}
							class='text-lg font-medium text-gray-700 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100 hover:underline underline-offset-2'>
							{link.label}
						</a>
					))
				}
			</div>
		</div>
	</RootLayout>
</html>
